# === Core ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brainmint
ENVIRONMENT=development
SITE_URL=https://brainmint.com

# === JWT & Security ===
SECRET_KEY=super_secret_jwt_key_ashutosh_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === Email Delivery ===
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp          # smtp | sendgrid | mailgun
EMAILS_FROM_EMAIL=BrainMint Software <hello@brainmint.com>
EMAILS_TO_EMAIL=ashutosh@brainmint.com

# SMTP (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@brainmint.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true

# SendGrid (used when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=SG.your-key-here

# Mailgun (used when EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=key-your-key-here
MAILGUN_DOMAIN=mg.brainmint.com

# === CAPTCHA ===
CAPTCHA_ENABLED=true
CAPTCHA_PROVIDER=hcaptcha    # hcaptcha | recaptcha
CAPTCHA_SECRET_KEY=your-hcaptcha-secret-key
RECAPTCHA_MIN_SCORE=0.5