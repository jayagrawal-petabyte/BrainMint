# === Core ===
DATABASE_URL=postgresql://user:password@localhost:5432/brainmint
ENVIRONMENT=development
SITE_URL=https://brainmint.com

# === Email Delivery ===
EMAIL_ENABLED=true
EMAIL_PROVIDER=smtp           # smtp | sendgrid | mailgun
EMAIL_FROM=BrainMint Software <hello@brainmint.com>
EMAIL_TEAM_TO=ashutosh@brainmint.com

# SMTP (used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=hello@brainmint.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

# SendGrid (used when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=SG.your-key-here

# Mailgun (used when EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=key-your-key-here
MAILGUN_DOMAIN=mg.brainmint.com

# === CAPTCHA ===
CAPTCHA_ENABLED=true
CAPTCHA_PROVIDER=hcaptcha     # hcaptcha | recaptcha
CAPTCHA_SECRET_KEY=your-hcaptcha-secret-key
# reCAPTCHA v3 minimum score (ignored for hCaptcha)
RECAPTCHA_MIN_SCORE=0.5
